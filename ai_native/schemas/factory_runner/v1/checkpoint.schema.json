  "$id": "urn:ai-native:factory-runner:v1:checkpoint",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_manifest": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifact Manifest",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "authority": {
      "$ref": "#/$defs/RunPolicy"
    },
    "budgets": {
      "$ref": "#/$defs/CheckpointBudgets"
    },
    "checkpoint_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checkpoint Digest",
      "type": "string"
    },
    "checkpoint_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/CheckpointCompatibility"
    },
    "completed_stages": {
      "items": {
        "enum": [
          "intake",
          "recon",
          "plan",
          "architecture",
          "prd",
          "slice",
          "loop",
          "verify"
        ],
        "type": "string"
      },
      "title": "Completed Stages",
      "type": "array",
      "uniqueItems": true
    },
    "context_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Bundle Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Created At",
      "type": "string"
    },
    "decisions": {
      "items": {
        "maxLength": 16384,
        "minLength": 1,
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "identity": {
      "$ref": "#/$defs/RunIdentity"
    },
    "next_permitted_stage": {
      "anyOf": [
        {
          "enum": [
            "intake",
            "recon",
            "plan",
            "architecture",
            "prd",
            "slice",
            "loop",
            "verify"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Permitted Stage"
    },
    "object_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
