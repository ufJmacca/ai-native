  "$id": "urn:ai-native:factory-runner:v1:runner-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attempt_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "correlation_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "RunnerStarted",
        "InputValidated",
        "CheckpointRestored",
        "StageStarted",
        "StageCompleted",
        "ToolStarted",
        "ToolCompleted",
        "TestStarted",
        "TestCompleted",
        "FileManifestChanged",
        "CheckpointWritten",
        "ChangeSetWritten",
        "VerificationEvidenceWritten",
        "PolicyDenied",
        "RunnerCancellationRequested",
        "RunnerCompleted",
        "RunnerFailed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "protocol": {
      "const": "factory-runner-protocol/v1",
      "title": "Protocol",
      "type": "string"
    },
    "run_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "sanitised_payload": {
      "additionalProperties": {
        "$ref": "#/$defs/SanitisedJsonDepth1"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "authorization",
            "branch_name",
            "credential",
            "github_token",
            "hidden_reasoning",
            "merge",
            "password",
            "pr_body",
            "pr_title",
            "publication_token",
            "pull_request",
            "raw_reasoning",
            "secret",
            "token"
          ]
        }
      },
      "type": "object"
    },
    "schema": {
      "const": "runner-event/v1",
      "title": "Schema",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "schema",
    "schema_version",
    "run_id",
    "attempt_id",
    "sequence",
    "timestamp",
    "event_type",
    "correlation_id",
    "causation_id",
    "sanitised_payload",
    "artifact_refs"
  ],
  "title": "RunnerEvent",
  "type": "object"
}
